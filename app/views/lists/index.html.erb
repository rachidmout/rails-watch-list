<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Lists</h1>
  </div>

  <% if @lists.any? %>
    <div class="row">
      <% @lists.each do |list| %>
        <div class="col-12 col-md-6 col-lg-4 mb-4">
          <%= link_to list_path(list), class: "text-decoration-none" do %>
            <div
              class="list-cover-card"
              style="
                background-image:
                  linear-gradient(rgba(0, 0, 0, 0.10), rgba(0, 0, 0, 0.82)),
                  url('<%= list.image_url %>');
              "
            >
              <div class="list-cover-content">
                <span class="list-label">WATCHLIST</span>

                <h2><%= list.name %></h2>

                <p>
                  <%= pluralize(list.movies.count, "movie") %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-dark border-secondary">
      No lists yet.
    </div>
  <% end %>
</div>
