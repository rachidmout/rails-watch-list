<div class="container py-4">
  <div
    class="lists-hero mb-5"
    style="
      background-image:
        linear-gradient(rgba(11, 13, 18, 0.10), rgba(11, 13, 18, 0.65)),
        url('<%= asset_path("default-list.png") %>');
    "
  >
    <div class="lists-hero-content">
      <p>Create collections and save the movies you want to remember.</p>
    </div>
  </div>

    <h2 class="mb-4">My Lists</h2>

  <% if @lists.any? %>
    <div class="row">
      <% @lists.each do |list| %>
        <% cover_style = list.photo.attached? ? "background-image: linear-gradient(rgba(0,0,0,0.10), rgba(0,0,0,0.82)), url('#{url_for(list.photo)}');" : "" %>

        <div class="col-12 col-md-6 col-lg-4 mb-4">
          <%= link_to list_path(list), class: "text-decoration-none" do %>
            <div class="list-cover-card <%= "list-cover-card--empty" unless list.photo.attached? %>" style="<%= cover_style %>">

              <div class="list-cover-content">
                <span class="list-label">WATCHLIST</span>

                <h2><%= list.name %></h2>

                <p>
                  <%= pluralize(list.movies.count, "movie") %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-dark border-secondary">
      No lists yet.
    </div>
  <% end %>
</div>
