<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <%= link_to "← Back to lists", lists_path, class: "btn btn-outline-light" %>


    <%= link_to "Delete list", list_path(@list), class: "btn btn-outline-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
  </div>

  <h1 class="mb-4"><%= @list.name %></h1>

  <% if @list.photo.attached? %>
  <%= image_tag @list.photo,
                class: "img-fluid rounded mb-4 w-100",
                style: "max-height: 420px; object-fit: cover;" %>
<% end %>

  <div class="card mb-4">
    <div class="card-body">
      <h2 class="h5 mb-3">Add a movie</h2>

      <%= simple_form_for [@list, @bookmark] do |f| %>
        <%= f.association :movie %>
        <%= f.input :comment %>
        <%= f.button :submit, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <% if @bookmarks.any? %>
    <div class="row">
      <% @bookmarks.each do |bookmark| %>
        <div class="col-12 col-md-6 col-lg-4 mb-4">
          <div class="card movie-card h-100">
            <%= image_tag bookmark.movie.poster_url, class: "card-img-top" %>

            <div class="card-body">
              <h5 class="card-title"><%= bookmark.movie.title %></h5>

              <p class="card-text">
                Rating: <%= bookmark.movie.rating %> / 10
              </p>

              <p class="card-text">
                <%= bookmark.comment %>
              </p>

              <%= link_to "Delete",
                          bookmark_path(bookmark),
                          class: "btn btn-outline-danger btn-sm",
                          data: {
                            turbo_method: :delete,
                            turbo_confirm: "Are you sure?"
                          } %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="d-flex justify-content-center mt-4">
      <%== @pagy.series_nav %>
    </div>
  <% else %>
    <div class="alert alert-light border">
      No movies in this list yet.
    </div>
  <% end %>

  <div class="card mt-5 mb-4">
    <div class="card-body">
      <h2 class="h5 mb-3">Leave a review</h2>

      <%= simple_form_for [@list, @review] do |f| %>
        <%= f.input :content %>
        <%= f.input :rating,
                    collection: 1..5,
                    prompt: "Choose a rating" %>
        <%= f.button :submit, "Add review", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="mt-4">
    <h2 class="h4 mb-3">Reviews</h2>

    <% if @list.reviews.any? %>
      <% @list.reviews.each do |review| %>
        <div class="card mb-3">
          <div class="card-body">
            <p class="mb-2">
              <strong>★ <%= review.rating %>/5</strong>
            </p>

            <p class="card-text"><%= review.content %></p>

            <%= link_to "Delete review",
                        review_path(review),
                        class: "btn btn-outline-danger btn-sm",
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: "Are you sure?"
                        } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-secondary">No reviews yet.</p>
    <% end %>
  </div>
</div>
